# Copy to .env in this directory (gitignored) and fill in the values.
# There is no Docker option for HANA: it attaches to a running SAP HANA Cloud instance,
# so HANA_HOST is required.

HANA_HOST=
HANA_PORT=443
HANA_USER=
HANA_PASSWORD=

# TLS (both default to true):
# HANA_ENCRYPT=true
# HANA_SSL_VALIDATE=true

# Reaching the instance through an SSH tunnel: the real hostname, sent as the TLS SNI.
# HANA_SNI_HOSTNAME=
# HANA_DISABLE_REDIRECT=true

# Retries of a connect that the endpoint resets mid-handshake (default 4):
# HANA_CONNECT_RETRIES=4
