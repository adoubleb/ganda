# Copy to .env in this directory (gitignored)
# Leave ORIENT_URL unset (or empty) and Ganda starts OrientDB in Docker.

# Attach to an OrientDB you already run instead of Docker (its HTTP address):
# ORIENT_URL=http://localhost:2480
# The server's root password (only used with ORIENT_URL):
# ORIENT_PASSWORD=

# Code coverage (`--coverage`) against an external server: its JaCoCo agent, host:port.
# ORIENT_JACOCO=
