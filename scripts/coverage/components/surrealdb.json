{
  "engine": "surrealdb",
  "paths": "as llvm-cov reports them for the build in /src, e.g. /src/surrealdb/core/src/exec/planner/select.rs",
  "scope": "^/?src/(surrealdb/[^/]+/src|src)/",
  "components": [
    [
      "/surrealdb/(syn|parser|parse-common|ast|token|sql)/src/",
      "parser"
    ],
    [
      "/surrealdb/core/src/syn/",
      "parser"
    ],
    [
      "/surrealdb/core/src/exec/(planner/|planner\\.rs|plan_or_compute\\.rs|topk_pushdown\\.rs|cardinality\\.rs|partitioning\\.rs|access_mode\\.rs)",
      "planner"
    ],
    [
      "/surrealdb/core/src/exec/(function|physical_expr|object_extract)/",
      "expressions"
    ],
    [
      "/surrealdb/core/src/exec/index",
      "indexes"
    ],
    [
      "/surrealdb/core/src/buc/",
      "storage"
    ],
    [
      "/surrealdb/core/src/ctx/",
      "executor"
    ],
    [
      "/surrealdb/core/src/(exec|dbs|doc|exe|legacy)/",
      "executor"
    ],
    [
      "/surrealdb/(expr|types|strand|sqon)/src/",
      "expressions"
    ],
    [
      "/surrealdb/core/src/fnc/",
      "expressions"
    ],
    [
      "/surrealdb/(idx)/src/",
      "indexes"
    ],
    [
      "/surrealdb/core/src/idx/",
      "indexes"
    ],
    [
      "/surrealdb/(kvs[^/]*|datastore|keyspace-macro)/src/",
      "storage"
    ],
    [
      "/surrealdb/core/src/(kvs|key)/",
      "storage"
    ],
    [
      "/surrealdb/catalog/src/",
      "catalog"
    ],
    [
      "/surrealdb/core/src/cf/",
      "catalog"
    ],
    [
      "/surrealdb/(server|rpc|node|iam|engine-api|engine-local|embedded|mcp|gql)/src/",
      "server"
    ],
    [
      "/surrealdb/core/src/(rpc|net|http|api|iam|gql|graphql)/",
      "server"
    ],
    [
      "^/?src/src/",
      "server"
    ]
  ]
}
